{
  "expo": {
    "name": "ADHD Task Manager",
    "slug": "adhd-task-manager",
    "version": "1.0.0",
    "main": "index.js",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#9333ea",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adhd.taskmanager",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to transcribe your voice braindumps."
      }
    },
    "android": {
      "package": "com.adhd.taskmanager",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow access to microphone for voice input"
        }
      ]
    ]
  }
}

